# 注意: .gitignore ではインライン（行末）コメント不可。コメントは必ず行頭に置く。

# ==== ビルド生成物（PDF） ====
docs/_book/
docs/design-doc.pdf

# ==== 中間生成物 ====
# Quarto の keep-typ 中間ファイル（通常は自動削除）
docs/index.typ

# ==== ツールの作業/キャッシュディレクトリ ====
# Quarto が typst パッケージ等をダウンロードするキャッシュ
.quarto/
**/*.quarto_ipynb

# ==== 依存パッケージ ====
node_modules/

# ==== mermaid 変換キャッシュ（内容ハッシュ名 mmd-xxxx.*） ====
# docs/diagrams/order-flow.* は同梱するため無視しない。
docs/diagrams/mmd-*
docs/diagrams/puppeteer.json

# ==== ページ目視確認用の一時画像（chk-*.png / page-*.png など） ====
docs/*.png

# ==== 配布スナップショット（配布時に作り直す） ====
*.zip

# ==== OS / エディタ ====
.DS_Store
Thumbs.db
*~
